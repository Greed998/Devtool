<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>../Shared/app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);GUI_SETUP</DefineConstants>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>DevToolboxAgent</AssemblyName>
    <RootNamespace>DevToolbox.Fleet.Agent</RootNamespace>
    <Product>DevToolbox Agent</Product>
    <Version>1.5.11</Version>
    <Company>Poltoli Informatika</Company>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Onallo: az ugyfelgepeken jellemzoen nincs .NET 10, es enelkul a szolgaltatas
         el sem indul (1053-as hiba). Nagyobb fajl, de mindenhol fut. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
    <!-- Hardver-érzékelők (hőmérséklet, ventilátor, fogyasztás, GPU) - a felhasználó jóváhagyásával (1.5.0); a DevToolbox
         ugyanezt a verziót használja. A CPU- és alaplap-érzékelőkhöz a PawnIO meghajtó kell (az agent wingettel telepíti). -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/Crypto.cs" />
    <Compile Include="../Shared/Protocol.cs" />
    <Compile Include="../Shared/Security.cs" />
    <Compile Include="../Shared/WizardForm.cs" />
    <Compile Include="../Shared/SetupCheck.cs" />
    <Compile Include="../Shared/NativeWin.cs" />
  </ItemGroup>
</Project>
