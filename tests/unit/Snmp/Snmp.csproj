<Project Sdk="Microsoft.NET.Sdk">
  <!-- SNMP-trap fogadás (1.5.5): BER, USM-kriptográfia (RFC 3414 tesztvektorok), v1 / v2c / v3 trap és inform.
       Az ÖSSZEVETÉSHEZ egy független megvalósítás (Lextm.SharpSnmpLib, MIT) küldi az üzeneteket - CSAK a tesztben,
       a termékbe nem kerül. Itt van az internetfigyelés (NetWatch) és a Központ esemény-átvétele is. -->
  <ItemGroup>
    <PackageReference Include="Lextm.SharpSnmpLib" Version="12.5.7" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(A)/Shared/Crypto.cs" />
    <Compile Include="$(A)/Shared/Security.cs" />
    <Compile Include="$(A)/Shared/Protocol.cs" />
    <Compile Include="$(A)/Shared/HubProtocol.cs" />
    <Compile Include="$(A)/Shared/NativeWin.cs" />
    <Compile Include="$(A)/Shared/ServiceSelfUpdate.cs" />
    <Compile Include="$(A)/Server/ServerConfig.cs" />
    <Compile Include="$(A)/Server/ServerTools.cs" />
    <Compile Include="$(A)/Server/Alerts.cs" />
    <Compile Include="$(A)/Server/Snmp.cs" />
    <Compile Include="$(A)/Server/SnmpReceiver.cs" />
    <Compile Include="$(A)/Server/NetWatch.cs" />
    <Compile Include="$(A)/Server/WireGuard.cs" />
    <Compile Include="$(A)/Hub/HubStore.cs" />
    <Compile Include="Test.cs" />
  </ItemGroup>
</Project>
